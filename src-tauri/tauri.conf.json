{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeNav",
  "version": "1.0.0",
  "identifier": "com.claudenav.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server.js": "server.js",
      "../public": "public"
    }
  }
}
